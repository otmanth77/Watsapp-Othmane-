rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validUsername(username) {
      return username.matches('^[a-z0-9_.-]{3,25}$');
    }

    function validLanguage(language) {
      return language in ['ar', 'fr', 'en', 'es'];
    }

    function validName(name) {
      return name is string
        && name.size() > 0
        && name.size() <= 60;
    }

    function isParticipant(chatId) {
      return signedIn()
        && request.auth.uid in
        get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{uid} {
      allow read: if signedIn()
        && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'name', 'username', 'phone', 'language'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'username', 'phone', 'language'
        ])
        && validName(request.resource.data.name)
        && validUsername(request.resource.data.username)
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^\\+[1-9][0-9]{7,14}$')
        && request.resource.data.phone == request.auth.token.phone_number
        && validLanguage(request.resource.data.language);

      allow update, delete: if false;
    }

    match /publicProfiles/{uid} {
      allow read: if true;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'name', 'username', 'language'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'username', 'language'
        ])
        && validName(request.resource.data.name)
        && validUsername(request.resource.data.username)
        && validLanguage(request.resource.data.language);

      allow update, delete: if false;
    }

    match /usernames/{username} {
      allow read: if true;

      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'createdBy', 'participants'
        ])
        && request.resource.data.keys().hasAll([
          'createdBy', 'participants'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] !=
           request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants;

      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);

        allow create: if isParticipant(chatId)
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'senderId', 'text', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
